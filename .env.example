# Copy to .env and fill in. Nothing here is required to run the app.

# --- LLM (optional; without it answers use the deterministic extractive fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Backends: in-process defaults need no infrastructure
GRAPH_BACKEND=networkx      # networkx | neo4j
VECTOR_BACKEND=numpy        # numpy    | chroma

# --- Neo4j (only read when GRAPH_BACKEND=neo4j). Matches docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=helios-dev-password
NEO4J_DATABASE=neo4j

# --- Retrieval tuning
TOP_K=3
CHUNK_TOKENS=110
CHUNK_OVERLAP=25
GRAPH_MAX_HOPS=3

# --- Your links. Leave blank to hide them in the UI.
AUTHOR_NAME=Ashish Pathak
AUTHOR_TAGLINE=Documentation, Knowledge Management & Content Engineering
PORTFOLIO_URL=
CALENDLY_URL=
LINKEDIN_URL=
GITHUB_URL=
